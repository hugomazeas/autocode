# Repo platform — for PR/MR creation after agent is done
REPO_PLATFORM=github              # github | gitlab | bitbucket
REPO_TOKEN=...                    # personal access token with repo + PR scope

# SSH key — for cloning repos
SSH_KEY_PATH=/run/secrets/ssh_key # path inside container
# OR inline:
# SSH_PRIVATE_KEY=...

# Optional
STAGING_URL=                      # if set, agent hits this to validate changes
MAX_TURNS=20                      # hard cap on agent iterations per job
